# ---------------------------------------------------------------------------
# Mailbox Operations Dashboard — example environment.
# Copy to `.env` and edit. NEVER commit the real `.env` (see .gitignore).
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# MVP: SQLite (default). Production: switch to PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mailbox_ops
DATABASE_URL=sqlite:///data/mailbox_ops.db

# --- Raw email storage (local only, optional) -------------------------------
STORE_RAW_EMAIL=true
RAW_STORAGE_DIR=data/raw

# --- Identity / domains -----------------------------------------------------
# Comma-separated domains treated as INTERNAL (agents/executives).
INTERNAL_DOMAINS=uidai.gov.in,uidai.net.in,nic.in
# The shared operational mailbox(es) outbound replies are sent FROM.
COMMON_MAILBOXES=helpdesk@uidai.gov.in

# --- Ticket / SLA / status --------------------------------------------------
STALE_DAYS=3
DEFAULT_SLA_HOURS=48
SLA_AT_RISK_HOURS=8

# --- Ingestion --------------------------------------------------------------
# export | live_sync | manual
INGESTION_MODE=export
EML_EXPORT_PATH=data/eml_exports

# --- IMAP (NIC Mail Cloud / intranet — Mode 1 production) -------------------
# Reachable only from UIDAI VPN once IMAP/POP access is approved.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX

# --- Gmail (Mode 1 dev/test ONLY) -------------------------------------------
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# --- Auth / session ---------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
PBKDF2_ITERATIONS=240000
